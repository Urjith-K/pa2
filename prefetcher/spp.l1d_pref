#include "cache.h"

// ---------------- IP table ----------------
// 8-way set-associative: an IP is looked up only in the 8 rows of its set,
// which is buildable at the L1D, unlike a 512-entry fully associative search.
// Measured: 8-way loses nothing against fully associative (REPORT.md).
#define IP_TRACKER_COUNT 512
#define IP_WAYS 8                                   // associativity (IP_TRACKER_COUNT = fully associative)
#define IP_SETS (IP_TRACKER_COUNT / IP_WAYS)        // 64 sets
#define IP_TAG_BITS 16
#define MASK_IP ((1 << IP_TAG_BITS) - 1)

// only the low LAST_ADDR_BITS of the last block are kept; the stride is
// computed modulo 2^LAST_ADDR_BITS, which is exact for any jump smaller than
// 32K blocks (2 MB)
#define LAST_ADDR_BITS 16
#define LAST_ADDR_MASK ((1ULL << LAST_ADDR_BITS) - 1)

// strides are stored in 7 bits (-64..63). A stride of a whole page (64
// blocks) or more can never produce a prefetch inside the page, so every such
// stride is stored as one value, STRIDE_FAR.
#define STRIDE_MAX 63
#define STRIDE_FAR (-64)

// ---------------- confidence (same rule for uniform and pattern) ----------------
#define CONF_MAX 3              // 2-bit saturating counter: 0..3
#define CONF_THRESHOLD 2        // prefetch only when confidence >= 2
#define UNIFORM_MISS_PENALTY 1  // uniform: a different stride costs 1, so one odd stride does not wipe out a trained stride
#define PATTERN_MISS_PENALTY 1  // pattern: a different stride costs 1

// ---------------- signature ----------------
#define SIG_LENGTH 3                                // number of past strides in a signature
#define SIG_STRIDE_BITS 5                           // bits kept from each stride
#define SIG_BITS (SIG_LENGTH * SIG_STRIDE_BITS)     // 15-bit signature
#define SIG_MASK ((1 << SIG_BITS) - 1)
#define SIG_STRIDE_MASK ((1 << SIG_STRIDE_BITS) - 1)

// ---------------- pattern table ----------------
#define PT_INDEX_BITS 8
#define PT_ENTRIES (1 << PT_INDEX_BITS)             // 256 entries, 7-bit tag
#define PT_INDEX_MASK (PT_ENTRIES - 1)

// ---------------- accuracy checker / throttling ----------------
#define PF_FILTER_BITS 8
#define PF_FILTER_SIZE (1 << PF_FILTER_BITS)        // recently prefetched blocks, direct mapped
#define PF_TAG_BITS 12                              // block bits kept above the index
#define PF_TAG_MASK ((1ULL << PF_TAG_BITS) - 1)
#define ACC_WINDOW 32           // re-check accuracy every 32 prefetches that filled the L1D

// states of an entry in the prefetch filter
#define PF_INVALID   0          // empty slot
#define PF_REQUESTED 1          // we sent the prefetch, block has not arrived in L1D yet
#define PF_FILLED    2          // the prefetch really brought the block into L1D
#define PF_REQUESTED_L2 3       // we sent the prefetch, but only into L2 (L1D MSHR was busy)

#define INITIAL_DEGREE 4
#define MIN_DEGREE 1
#define MAX_DEGREE 16
#define ACC_UP   60             // accuracy above 60%  -> degree + 1
#define ACC_DOWN 40             // accuracy below 40%  -> degree - 1
                                // in between          -> degree stays the same


// ---------------- one row of the IP table ----------------
class IP_TRACKER {
  public:
    uint64_t ip;                // IP tag (IP_TAG_BITS)
    uint64_t last_cl_addr;      // low LAST_ADDR_BITS of the last block this IP accessed

    // uniform detector: the stride we trust, and how much we trust it
    int64_t last_stride;
    uint32_t confidence;

    // non-uniform detector: the last SIG_LENGTH strides packed into one number
    uint32_t signature;

    // how many strides we have seen so far (stops at SIG_LENGTH); the
    // signature is only used once it holds SIG_LENGTH real strides
    uint32_t num_strides;

    uint32_t lru;               // LRU age, used to evict old IP trackers

    IP_TRACKER () {
        ip = 0;
        last_cl_addr = 0;
        last_stride = 0;
        confidence = 0;
        signature = 0;
        num_strides = 0;
        lru = 0;
    };
};

// ---------------- one entry of the pattern table ----------------
class SPP_PATTERN_ENTRY {
  public:
    // upper bits of the signature that owns this entry; together with the
    // index this identifies the signature exactly
    uint32_t tag;

    int64_t next_stride;        // the stride that usually follows this signature
    uint32_t confidence;        // how much we trust next_stride (0..3)

    SPP_PATTERN_ENTRY () {
        tag = 0;
        next_stride = 0;
        confidence = 0;
    };
};

IP_TRACKER trackers[IP_TRACKER_COUNT];
SPP_PATTERN_ENTRY spp_pattern_table[PT_ENTRIES];

// accuracy checker: recently prefetched blocks (partial tag) and their state
uint64_t spp_pf_filter[PF_FILTER_SIZE];
uint32_t spp_pf_filter_state[PF_FILTER_SIZE];

// accuracy checker: counters for the current window
uint32_t spp_window_issued = 0;
uint32_t spp_window_useful = 0;

// prefetch degree, changed at run time by the accuracy checker
uint32_t spp_degree = INITIAL_DEGREE;

// statistics printed at the end
uint64_t spp_stat_requested = 0;   // prefetch requests sent to the prefetch queue
uint64_t spp_stat_issued = 0;      // prefetches that really filled a block into L1D
uint64_t spp_stat_useful = 0;
uint64_t spp_stat_uniform_pf = 0;
uint64_t spp_stat_pattern_pf = 0;
uint64_t spp_stat_degree_windows[MAX_DEGREE + 1];

// statistics only count the measured part of the run: warmup runs with
// unrealistically fast memory, so its numbers would be misleading
uint32_t spp_stats_reset_done = 0;


// ============================================================================
//  helper functions
// ============================================================================

// squeeze a stride into its 7-bit field: anything a page or more away
// becomes STRIDE_FAR, which never yields an in-page prefetch
int64_t spp_clamp_stride(int64_t stride)
{
    if (stride > STRIDE_MAX || stride < -STRIDE_MAX)
        return STRIDE_FAR;
    return stride;
}

// shared confidence rule, used by both detectors:
//   same stride        -> confidence +1 (max CONF_MAX)
//   different stride   -> confidence -penalty (min 0)
//   confidence hits 0  -> replace the stored stride with the new one, confidence 1
void spp_train(int64_t &stored_stride, uint32_t &conf, int64_t new_stride, uint32_t penalty)
{
    if (new_stride == stored_stride) {
        if (conf < CONF_MAX)
            conf++;
    }
    else {
        if (conf > penalty)
            conf -= penalty;
        else
            conf = 0;

        if (conf == 0) {
            stored_stride = new_stride;
            conf = 1;
        }
    }
}

// slide a new stride into a signature: the oldest stride falls out,
// the newest goes in (each stride keeps its low SIG_STRIDE_BITS bits)
uint32_t spp_update_signature(uint32_t sig, int64_t stride)
{
    return ((sig << SIG_STRIDE_BITS) | ((uint32_t)stride & SIG_STRIDE_MASK)) & SIG_MASK;
}

// which pattern table entry a signature uses, and the tag stored there
uint32_t spp_pt_index(uint32_t sig) { return (sig ^ (sig >> PT_INDEX_BITS)) & PT_INDEX_MASK; }
uint32_t spp_pt_tag(uint32_t sig)   { return (sig >> PT_INDEX_BITS); }

// teach the pattern table: "after signature sig, the stride new_stride came"
void spp_train_pattern(uint32_t sig, int64_t new_stride)
{
    SPP_PATTERN_ENTRY &entry = spp_pattern_table[spp_pt_index(sig)];
    uint32_t tag = spp_pt_tag(sig);

    if (entry.tag == tag) {
        // this entry belongs to our signature: normal confidence update
        spp_train(entry.next_stride, entry.confidence, new_stride, PATTERN_MISS_PENALTY);
    }
    else {
        // the entry belongs to another signature: weaken it, and take it
        // over only once its confidence reaches 0
        if (entry.confidence > 0)
            entry.confidence--;

        if (entry.confidence == 0) {
            entry.tag = tag;
            entry.next_stride = new_stride;
            entry.confidence = 1;
        }
    }
}

// ask the pattern table what comes after signature sig;
// returns true (and the stride) only if the entry is ours and confident
bool spp_predict(uint32_t sig, int64_t &stride)
{
    SPP_PATTERN_ENTRY &entry = spp_pattern_table[spp_pt_index(sig)];

    if (entry.tag == spp_pt_tag(sig) && entry.confidence >= CONF_THRESHOLD) {
        stride = entry.next_stride;
        return true;
    }
    return false;
}

// the prefetch filter is direct mapped on the low block bits and keeps only a
// PF_TAG_BITS partial tag of the bits above them
uint32_t spp_pf_slot(uint64_t cl_addr) { return cl_addr & (PF_FILTER_SIZE - 1); }
uint64_t spp_pf_tag(uint64_t cl_addr)  { return (cl_addr >> PF_FILTER_BITS) & PF_TAG_MASK; }

// find a block in the prefetch filter; returns its slot, or -1 if it is not there
int spp_find_pf_filter(uint64_t cl_addr)
{
    int slot = spp_pf_slot(cl_addr);
    if (spp_pf_filter_state[slot] != PF_INVALID && spp_pf_filter[slot] == spp_pf_tag(cl_addr))
        return slot;
    return -1;
}

// put a block in its filter slot with the given state (replaces whatever was there)
void spp_add_pf_filter(uint64_t cl_addr, uint32_t state)
{
    int slot = spp_pf_slot(cl_addr);
    spp_pf_filter[slot] = spp_pf_tag(cl_addr);
    spp_pf_filter_state[slot] = state;
}

// clear the statistics once, when warmup ends
void spp_reset_stats()
{
    spp_stat_requested = 0;
    spp_stat_issued = 0;
    spp_stat_useful = 0;
    spp_stat_uniform_pf = 0;
    spp_stat_pattern_pf = 0;
    for (int i=0; i<=MAX_DEGREE; i++)
        spp_stat_degree_windows[i] = 0;
    spp_stats_reset_done = 1;
}

// every ACC_WINDOW issued prefetches: compute accuracy and step the degree up or down
void spp_update_degree()
{
    if (spp_window_issued < ACC_WINDOW)
        return;

    uint32_t accuracy = (spp_window_useful * 100) / spp_window_issued;

    // step the degree up or down by 1, staying between MIN_DEGREE and MAX_DEGREE
    if (accuracy > ACC_UP && spp_degree < MAX_DEGREE)
        spp_degree++;
    else if (accuracy < ACC_DOWN && spp_degree > MIN_DEGREE)
        spp_degree--;

    spp_stat_degree_windows[spp_degree]++;

    // start a new window
    spp_window_issued = 0;
    spp_window_useful = 0;
}

// send one prefetch for block pf_cl_addr; returns 1 if it was sent
int spp_issue(CACHE *cache, uint64_t ip, uint64_t addr, uint64_t pf_cl_addr)
{
    // already prefetched recently -> don't send it again
    if (spp_find_pf_filter(pf_cl_addr) != -1)
        return 0;

    uint64_t pf_address = pf_cl_addr << LOG2_BLOCK_SIZE;
    int sent;

    // same MSHR rule as IP-stride: L1 if there is room, otherwise only L2
    bool to_l1 = (cache->MSHR.occupancy < (cache->MSHR.SIZE>>1));
    if (to_l1)
        sent = cache->prefetch_line(ip, addr, pf_address, FILL_L1, 0);
    else
        sent = cache->prefetch_line(ip, addr, pf_address, FILL_L2, 0);

    // remember it as REQUESTED; it is only counted as issued once it
    // really arrives in the L1D (see cache_fill)
    if (sent) {
        spp_add_pf_filter(pf_cl_addr, to_l1 ? PF_REQUESTED : PF_REQUESTED_L2);
        spp_stat_requested++;
    }
    return sent;
}


// ============================================================================
//  ChampSim hooks
// ============================================================================

void CACHE::l1d_prefetcher_initialize()
{
    std::cout << "CPU " << cpu << " L1D Stride Pattern Prefetcher (SPP)" << std::endl;

    for (int i=0; i<IP_TRACKER_COUNT; i++)
        trackers[i].lru = i % IP_WAYS;

    for (int i=0; i<PF_FILTER_SIZE; i++)
        spp_pf_filter_state[i] = PF_INVALID;

    for (int i=0; i<=MAX_DEGREE; i++)
        spp_stat_degree_windows[i] = 0;
}

void CACHE::l1d_prefetcher_operate(uint64_t addr, uint64_t ip, uint8_t cache_hit, uint8_t type, uint8_t critical_ip_flag)
{
    // only learn from demand loads
    if (type != LOAD)
        return;

    // warmup just ended -> start the statistics from zero
    if (warmup_complete[cpu] && !spp_stats_reset_done)
        spp_reset_stats();

    uint64_t cl_addr = addr >> LOG2_BLOCK_SIZE;

    // ---------- accuracy checker ----------
    // the program is loading this block: if one of our prefetches brought it
    // into the L1D, that prefetch was useful. Either way the entry is done.
    int slot = spp_find_pf_filter(cl_addr);
    if (slot != -1) {
        if (spp_pf_filter_state[slot] == PF_FILLED) {
            spp_window_useful++;
            spp_stat_useful++;
        }
        spp_pf_filter_state[slot] = PF_INVALID;
    }
    spp_update_degree();

    // ---------- find this IP's row ----------
    // set-associative: the low bits of the IP tag pick a set of IP_WAYS rows,
    // which is searched like IP-stride searches its whole table
    uint64_t ip_tag = ip & MASK_IP;
    uint64_t short_addr = cl_addr & LAST_ADDR_MASK;
    int base = (ip_tag % IP_SETS) * IP_WAYS;

    int index = -1;
    for (int w=0; w<IP_WAYS; w++) {
        if (trackers[base + w].ip == ip_tag) {
            index = base + w;
            break;
        }
    }

    // this is a new IP that doesn't have a tracker yet, so allocate one
    if (index == -1) {

        for (int w=0; w<IP_WAYS; w++) {
            if (trackers[base + w].lru == (IP_WAYS-1)) {
                index = base + w;
                break;
            }
        }
        assert(index != -1);

        trackers[index].ip = ip_tag;
        trackers[index].last_cl_addr = short_addr;
        trackers[index].last_stride = 0;
        trackers[index].confidence = 0;     // new IP: no trust yet
        trackers[index].signature = 0;      // new IP: no stride history yet
        trackers[index].num_strides = 0;

        for (int w=0; w<IP_WAYS; w++) {
            if (trackers[base + w].lru < trackers[index].lru)
                trackers[base + w].lru++;
        }
        trackers[index].lru = 0;

        // one block shows no stride, so there is nothing to predict yet
        return;
    }

    // mark this IP as most recently used now, before any early return, so
    // IPs that keep loading the same block are not evicted first
    for (int w=0; w<IP_WAYS; w++) {
        if (trackers[base + w].lru < trackers[index].lru)
            trackers[base + w].lru++;
    }
    trackers[index].lru = 0;

    // ---------- compute the stride ----------
    // subtract modulo 2^LAST_ADDR_BITS and sign-extend, so a backward stride
    // comes out negative instead of wrapping to a huge number
    int64_t stride = (int64_t)((short_addr - trackers[index].last_cl_addr) & LAST_ADDR_MASK);
    if (stride >= (1LL << (LAST_ADDR_BITS - 1)))
        stride -= (1LL << LAST_ADDR_BITS);

    // two accesses inside one block carry no information
    if (stride == 0)
        return;

    stride = spp_clamp_stride(stride);

    // ---------- 1) train the uniform detector ----------
    spp_train(trackers[index].last_stride, trackers[index].confidence, stride, UNIFORM_MISS_PENALTY);

    // ---------- 2) train the non-uniform detector ----------
    // "after the last SIG_LENGTH strides, this stride came"
    if (trackers[index].num_strides == SIG_LENGTH)
        spp_train_pattern(trackers[index].signature, stride);

    trackers[index].signature = spp_update_signature(trackers[index].signature, stride);
    if (trackers[index].num_strides < SIG_LENGTH)
        trackers[index].num_strides++;

    // ---------- 3) decide and prefetch ----------
    // a uniform run inside a repeating pattern (the +2,+2,+2 of +1,+2,+2,+2,+3)
    // looks confident, but the pattern table knows the next stride is different,
    // so the pattern table is allowed to veto the uniform prediction.
    // A confident STRIDE_FAR can never prefetch, so it does not count as a
    // uniform prediction and the pattern table gets its chance instead.
    int64_t pt_stride = 0;
    bool pt_confident = (trackers[index].num_strides == SIG_LENGTH) && spp_predict(trackers[index].signature, pt_stride);
    bool pt_disagrees = pt_confident && (pt_stride != trackers[index].last_stride);
    bool uniform_ok = (trackers[index].confidence >= CONF_THRESHOLD) && (trackers[index].last_stride != STRIDE_FAR);

    if (uniform_ok && !pt_disagrees) {

        // UNIFORM: prefetch cl + s, cl + 2s, ... cl + degree*s
        for (uint32_t i=0; i<spp_degree; i++) {
            uint64_t pf_cl_addr = cl_addr + (trackers[index].last_stride * (i+1));
            uint64_t pf_address = pf_cl_addr << LOG2_BLOCK_SIZE;

            // only prefetch inside the same 4 KB page
            if ((pf_address >> LOG2_PAGE_SIZE) != (addr >> LOG2_PAGE_SIZE))
                break;

            if (spp_issue(this, ip, addr, pf_cl_addr))
                spp_stat_uniform_pf++;
        }
    }
    else if (pt_confident) {

        // NON-UNIFORM: chain predictions from the pattern table. Each predicted
        // stride is fed into a temporary signature to predict the stride after it.
        uint32_t spec_signature = trackers[index].signature;
        uint64_t pf_cl_addr = cl_addr;

        for (uint32_t i=0; i<spp_degree; i++) {
            int64_t next_stride = 0;

            // stop if the pattern table doesn't confidently know what comes next
            if (!spp_predict(spec_signature, next_stride))
                break;

            pf_cl_addr = pf_cl_addr + next_stride;
            uint64_t pf_address = pf_cl_addr << LOG2_BLOCK_SIZE;

            // only prefetch inside the same 4 KB page (this also ends the
            // chain on STRIDE_FAR)
            if ((pf_address >> LOG2_PAGE_SIZE) != (addr >> LOG2_PAGE_SIZE))
                break;

            if (spp_issue(this, ip, addr, pf_cl_addr))
                spp_stat_pattern_pf++;

            spec_signature = spp_update_signature(spec_signature, next_stride);
        }
    }

    trackers[index].last_cl_addr = short_addr;
    return;
}

void CACHE::l1d_prefetcher_cache_fill(uint64_t v_addr, uint64_t addr, uint32_t set, uint32_t way, uint8_t prefetch, uint64_t v_evicted_addr, uint64_t evicted_addr, uint32_t metadata_in)
{
    // only blocks brought in by our prefetches matter for the accuracy checker
    if (!prefetch)
        return;

    // v_addr is the virtual address, the same kind of address operate() sees
    uint64_t cl_addr = v_addr >> LOG2_BLOCK_SIZE;

    // this prefetch really brought a block into the L1D -> count it as issued
    spp_add_pf_filter(cl_addr, PF_FILLED);

    spp_window_issued++;
    spp_stat_issued++;
}

void CACHE::l1d_prefetcher_final_stats()
{
    std::cout << "CPU " << cpu << " L1D SPP prefetch requests: " << spp_stat_requested
              << "  filled into L1D: " << spp_stat_issued
              << "  useful: " << spp_stat_useful << std::endl;

    if (spp_stat_issued > 0)
        std::cout << "CPU " << cpu << " L1D SPP accuracy: "
                  << (100.0 * spp_stat_useful / spp_stat_issued) << "%" << std::endl;

    std::cout << "CPU " << cpu << " L1D SPP uniform prefetches: " << spp_stat_uniform_pf
              << "  pattern prefetches: " << spp_stat_pattern_pf << std::endl;

    std::cout << "CPU " << cpu << " L1D SPP windows at each degree:";
    for (int i=1; i<=MAX_DEGREE; i++)
        std::cout << "  d" << i << "=" << spp_stat_degree_windows[i];
    std::cout << std::endl;
}
